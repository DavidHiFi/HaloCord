{
    "name": "testcord",
    "private": "true",
    "version": "2.3.0",
    "description": "The less stable fork of Equicord",
    "homepage": "https://github.com/TestcordDev/Testcord#readme",
    "bugs": {
        "url": "https://github.com/TestcordDev/Testcord/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TestcordDev/Testcord.git"
    },
    "license": "GPL-3.0-or-later",
    "author": "x2b",
    "scripts": {
        "build": "pnpm depCheck && pnpm generateBDPlugins && node --require=./scripts/suppressExperimentalWarnings.js scripts/build/build.mjs",
        "buildStandalone": "pnpm build --standalone",
        "buildWeb": "pnpm depCheck && pnpm generateBDPlugins && node --require=./scripts/suppressExperimentalWarnings.js scripts/build/buildWeb.mjs",
        "buildWebStandalone": "pnpm buildWeb --standalone",
        "buildReporter": "pnpm buildWebStandalone --reporter --skip-extension",
        "buildReporterDesktop": "pnpm build --reporter",
        "watch": "pnpm build --watch",
        "dev": "pnpm watch",
        "watchWeb": "pnpm buildWeb --watch",
        "generateDevsList": "tsx scripts/generateDevsList.ts",
        "generatePluginJson": "tsx scripts/generatePluginList.ts",
        "generateEquicordPluginJson": "tsx scripts/generatePluginList.ts --equicord",
        "generateVencordPluginJson": "tsx scripts/generatePluginList.ts --vencord",
        "generateTestcordPluginJson": "tsx scripts/generatePluginList.ts --testcord",
        "generateTypes": "tspc --emitDeclarationOnly --declaration --outDir packages/vencord-types --allowJs false",
        "inject": "node scripts/runInstaller.mjs -- --install",
        "uninject": "node scripts/runInstaller.mjs -- --uninstall",
        "repair": "node scripts/runInstaller.mjs -- --repair",
        "lint": "eslint",
        "lint-styles": "stylelint \"src/**/*.css\" --ignore-pattern src/userplugins",
        "lint-styles:fix": "pnpm lint-styles --fix",
        "lint:fix": "pnpm lint --fix",
        "lint:intl": "node scripts/lintIntl.mjs",
        "lint:css": "node scripts/lintCssSelectors.mjs",
        "lint:patches": "node scripts/lintPatches.mjs",
        "lint:runtime-hooks": "node scripts/lintRuntimeInterposition.mjs",
        "test:unit": "node --import tsx --test tests/**/*.test.ts",
        "test": "pnpm buildStandalone && pnpm testTsc && pnpm lint:fix && pnpm lint-styles && pnpm lint:intl && pnpm lint:css && pnpm lint:patches && pnpm generatePluginJson",
        "testWeb": "pnpm lint:fix && pnpm buildWeb && pnpm testTsc",
        "testTsc": "tsc --noEmit",
        "depCheck": "node scripts/depCheck.mjs",
        "generateBDPlugins": "node scripts/generateBDPlugins.mjs",
        "loadBDPlugins": "node scripts/loadBDPlugins.mjs"
    },
    "dependencies": {
        "@ffmpeg/ffmpeg": "^0.12.10",
        "@ffmpeg/util": "^0.12.1",
        "@intrnl/xxhash64": "^0.1.2",
        "@song-spotlight/api": "^2.2.0",
        "@streamparser/json": "^0.0.26",
        "@vap/core": "0.0.12",
        "@vap/shiki": "0.10.5",
        "fflate": "^0.8.3",
        "gifenc": "github:mattdesl/gifenc#64842fca317b112a8590f8fef2bf3825da8f6fe3",
        "gifuct-js": "^2.1.2",
        "idb": "8.0.4",
        "jsqr": "1.4.0",
        "monaco-editor": "^0.57.0",
        "nanoid": "^6.0.2",
        "native-file-system-adapter": "^3.0.1",
        "virtual-merge": "^1.0.1",
        "yaml-js": "^0.3.1"
    },
    "devDependencies": {
        "@electron/asar": "^4.3.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/chrome": "^0.3.7",
        "@types/lodash": "^4.17.27",
        "@types/node": "^26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/yazl": "^3.3.1",
        "@vencord/discord-types": "link:packages/discord-types",
        "diff": "^9.0.0",
        "esbuild": "^0.28.2",
        "eslint": "10.13.0",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-simple-header": "^1.2.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "highlight.js": "11.12.0",
        "html-minifier-terser": "^7.2.0",
        "md5": "^2.3.0",
        "moment": "^2.31.0",
        "p-limit": "^7.3.3",
        "puppeteer-core": "^25.16.0",
        "standalone-electron-types": "^41.2.1",
        "stylelint": "^17.16.0",
        "stylelint-config-standard": "^40.0.0",
        "svgo": "^4.1.0",
        "ts-patch": "^4.0.1",
        "ts-pattern": "^5.9.2",
        "tsx": "^4.23.15",
        "type-fest": "^5.10.0",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.72.1",
        "typescript-transform-paths": "^4.0.0",
        "zip-local": "^0.3.5"
    },
    "packageManager": "pnpm@12.11.2",
    "engines": {
        "node": ">=22"
    }
}
