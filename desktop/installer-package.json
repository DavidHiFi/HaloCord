{
  "name": "halocord",
  "productName": "HaloCord",
  "version": "2.11.8",
  "description": "HaloCord",
  "author": {
    "name": "DavidHiFi",
    "url": "https://github.com/DavidHiFi"
  },
  "build": {
    "appId": "com.davidhifi.halocord",
    "productName": "HaloCord",
